{
  "name": "cv-template",
  "version": "1.0.0",
  "private": true,
  "description": "Template de CV (A4, 2 páginas) em TypeScript + Tailwind CSS",
  "scripts": {
    "dev": "tsx src/scripts/build.ts",
    "build": "tsx src/scripts/build.ts",
    "build:html": "tsx src/scripts/build-html.ts",
    "build:pdf": "tsx src/scripts/build-pdf.ts",
    "build:docx": "tsx src/scripts/build-docx.ts",
    "build:css": "tailwindcss -c tailwind.config.ts -i ./src/styles/input.css -o ./dist/output.css"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "puppeteer": "^25.12.0"
  }
}
